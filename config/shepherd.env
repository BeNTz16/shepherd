# Example models: replace these with models available in your Codex account.
# Existing environment variables take precedence. This file is trusted shell code.
: "${SHEPHERD_MODEL_LUNA:=gpt-6-luna}"
: "${SHEPHERD_MODEL_SOL:=gpt-6.1-sol}"
: "${SHEPHERD_MODEL_ASTRA:=gpt-6-astra}"
: "${SHEPHERD_MODEL_RESERVE:=gpt-reserve}"
# Normal luna/sol ceiling is high; these ceilings require --escalate.
: "${SHEPHERD_LUNA_MAX_EFFORT:=max}"
: "${SHEPHERD_SOL_MAX_EFFORT:=xhigh}"
: "${SHEPHERD_RESERVE_MAX_EFFORT:=max}"
: "${SHEPHERD_CRITICAL_TIER:=sol}"
: "${SHEPHERD_CRITICAL_MIN_EFFORT:=high}"
# Astra is always low; sol never permits low or max.
: "${SHEPHERD_TIMEOUT:=420}"
: "${SHEPHERD_ESCALATED_TIMEOUT:=600}"
: "${SHEPHERD_TIMEOUT_MAX:=420}"
: "${SHEPHERD_ESCALATED_TIMEOUT_MAX:=600}"
: "${SHEPHERD_RESUME_TIMEOUT:=90}"
: "${SHEPHERD_KILL_AFTER:=10}"
: "${SHEPHERD_CAPACITY_WAIT:=45}"
: "${SHEPHERD_CAPACITY_RETRY_DIV:=2}"
: "${SHEPHERD_SOL_LIMIT:=2}"
: "${SHEPHERD_SLOT_WAIT:=1800}"
: "${SHEPHERD_READ_SOFT_PERCENT:=85}"
: "${SHEPHERD_WRITE_SOFT_PERCENT:=80}"
: "${SHEPHERD_TERSE:=full}"
: "${SHEPHERD_DISABLE_MULTI_AGENT:=1}"
: "${SHEPHERD_SCOPE_RULES:=Work independently. Do not spawn agents. Use rg to locate symbols; read relevant line ranges, not whole files. Search only inside the workdir. Change only named target files. Follow project instructions. Do not add unrequested features or refactors; report suggestions separately. Prove a bug root cause with file:line before fixing it; otherwise report partial status without speculative workarounds. Do not request sandbox escapes, network access, or live browser checks. Leave unavailable checks to the lead. Complete status means assigned scope is finished; list external validation under open items.}"
: "${SHEPHERD_REPORT_FORMAT:=STATUS: complete | partial | failed
CHANGED FILES: path:line-range and change, or none
CRITERIA: PASS/FAIL per criterion with evidence
CHECKS RUN: command and result
OPEN ITEMS / BLOCKERS: remaining bounded subtasks, or none
SUGGESTIONS (not applied): out-of-scope ideas, or none}"
: "${POST_WRITE_CHECK:=}"
